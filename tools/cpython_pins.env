# cpython_pins.env -- pinned CPython source tarballs for the build_*_cpython.sh
# helpers. Sourced, not executed.
#
# Every pin here was verified against the sigstore bundle python.org publishes
# beside the tarball (Python-<ver>.tgz.sigstore): the sha256 below equals the
# digest inside the bundle, and the bundle's signing certificate names that
# series' release manager. See tools/fetch_pinned.sh for what was and was not
# checked -- the Rekor inclusion proof was not.
#
# ADDING A VERSION is deliberate, and the hash must come from the bundle, never
# from "whatever the download gave me":
#
#   V=3.14.5
#   curl -fsSLO https://www.python.org/ftp/python/$V/Python-$V.tgz
#   curl -fsSLO https://www.python.org/ftp/python/$V/Python-$V.tgz.sigstore
#   python3 -c "import json,base64,hashlib,sys; \
#     b=json.load(open('Python-$V.tgz.sigstore')); \
#     d=base64.b64decode(b['messageSignature']['messageDigest']['digest']).hex(); \
#     f=hashlib.sha256(open('Python-$V.tgz','rb').read()).hexdigest(); \
#     print('signed:',d); print('actual:',f); print('MATCH' if d==f else 'MISMATCH')"
#
# An unpinned version is REFUSED rather than fetched. That is the point: a build
# script that quietly downloads whatever you name is the hole this closes.

RL_CPYTHON_PINS="
3.14.4     b4c059d5895f030e7df9663894ce3732bfa1b32cd3ab2883980266a45ce3cb3b
3.13.13    f9cde7b0e2ec8165d7326e2a0f59ea2686ce9d0c617dbbb3d66a7e54d31b74b9
"

# rl_cpython_sha <version> -> prints sha256, empty if unpinned
rl_cpython_sha() {
    printf '%s\n' "$RL_CPYTHON_PINS" | while read -r _v _s; do
        [ "$_v" = "$1" ] && { printf '%s' "$_s"; return 0; }
    done
}

# rl_cpython_require_pin <version> -> prints sha256, or explains and exits 1
rl_cpython_require_pin() {
    _s="$(rl_cpython_sha "$1")"
    if [ -z "$_s" ]; then
        echo "ERROR: CPython $1 is not pinned in tools/cpython_pins.env." >&2
        echo "This script will not download an unverified interpreter tarball." >&2
        echo "Add a '<version>  <sha256>' row -- see the header of that file for" >&2
        echo "how to take the hash from python.org's sigstore bundle rather than" >&2
        echo "from the download itself." >&2
        return 1
    fi
    printf '%s' "$_s"
}
