--- a/Include/internal/pycore_pystate.h
+++ b/Include/internal/pycore_pystate.h
@@ -133,12 +133,77 @@
    The caller must hold the GIL.
 
    See also PyThreadState_Get() and PyThreadState_GetUnchecked(). */
+/* Py_TSTATE_EXEC_HOME: which targets have an LTO-safe inline TLS read.
+   Independent of Py_BUILD_CORE_MODULE so the LTO guard below can see it. */
+#if defined(Py_TSTATE_EXEC_HOME) && defined(HAVE_THREAD_LOCAL)
+#  if defined(__x86_64__) && defined(__ELF__)
+#    define _Py_TSTATE_TLS_READ_AVAILABLE 1
+#  elif defined(__aarch64__) && defined(__APPLE__) && defined(__clang__)
+#    define _Py_TSTATE_TLS_READ_AVAILABLE 1
+#  endif
+#endif
+#if defined(Py_TSTATE_EXEC_HOME) && !defined(_Py_TSTATE_TLS_READ_AVAILABLE) \
+    && defined(PY_HAVE_LTO)
+#  error "Py_TSTATE_EXEC_HOME with LTO needs the inline TLS asm (x86-64 ELF or arm64 Darwin/clang); this target would silently reintroduce the migration UAF. Rebuild without --with-lto."
+#endif
+#if defined(_Py_TSTATE_TLS_READ_AVAILABLE) && !defined(Py_BUILD_CORE_MODULE)
+/* Read _Py_tss_tstate through a volatile asm that does the thread-pointer-
+   relative load itself.  It runs at every use and cannot be hoisted, CSE'd or
+   folded by LTO, so a read after a park/resume sees the resuming thread's
+   slot -- without a call's register spills.  The "memory" clobber is load-
+   bearing: volatile alone does not stop the compiler from DSE'ing / sinking a
+   preceding C write of the same TLS slot past the asm.  Used by
+   _PyThreadState_GET() and pystate.c's current_fast_get(). */
+#  if defined(__x86_64__) && defined(__ELF__)
+#    define _Py_HAVE_TSTATE_TLS_READ 1
+static inline PyThreadState *
+_Py_tstate_tls_read(void)
+{
+    PyThreadState *tstate;
+    __asm__ __volatile__(
+        "movq _Py_tss_tstate@gottpoff(%%rip), %0\n\t"
+        "movq %%fs:(%0), %0"
+        : "=r" (tstate)
+        :
+        : "memory");
+    return tstate;
+}
+/* Native Darwin TLV only -- GCC on Darwin uses emulated TLS (__emutls_*), so
+   these @TLVPPAGE relocs are undefined at link.  Fall through to the
+   out-of-line call on non-clang. */
+#  elif defined(__aarch64__) && defined(__APPLE__) && defined(__clang__)
+#    define _Py_HAVE_TSTATE_TLS_READ 1
+static inline PyThreadState *
+_Py_tstate_tls_read(void)
+{
+    /* A TLV access is a call through the descriptor to _tlv_get_addr, which
+       preserves all registers but x0/x16/x17/lr. */
+    register PyThreadState *tstate __asm__("x0");
+    __asm__ __volatile__(
+        "adrp x0, __Py_tss_tstate@TLVPPAGE\n\t"
+        "ldr x0, [x0, __Py_tss_tstate@TLVPPAGEOFF]\n\t"
+        "ldr x16, [x0]\n\t"
+        "blr x16\n\t"
+        "ldr x0, [x0]"
+        : "=r" (tstate)
+        :
+        : "x16", "x17", "x30", "cc", "memory");
+    return tstate;
+}
+#  endif
+#endif
+
 static inline PyThreadState*
 _PyThreadState_GET(void)
 {
-#if defined(HAVE_THREAD_LOCAL) && !defined(Py_BUILD_CORE_MODULE)
+#if defined(HAVE_THREAD_LOCAL) && !defined(Py_BUILD_CORE_MODULE) \
+    && !defined(Py_TSTATE_EXEC_HOME)
     return _Py_tss_tstate;
+#elif defined(_Py_HAVE_TSTATE_TLS_READ)
+    return _Py_tstate_tls_read();
 #else
+    /* No inline form for this target: keep it a real call (see
+       _PyThreadState_GetCurrent() in Python/pystate.c). */
     return _PyThreadState_GetCurrent();
 #endif
 }
