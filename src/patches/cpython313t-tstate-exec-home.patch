   LDFLAGS_NODIST="$LDFLAGS_NODIST $LTOFLAGS"
+
+  AC_DEFINE([PY_HAVE_LTO], [1],
+    [Define if built with --with-lto.])
+  dnl Py_TSTATE_EXEC_HOME (runloom): LTO is only safe with the inline TLS asm
+  dnl (x86-64 ELF, arm64 Darwin/clang).  Refuse elsewhere when the feature is
+  dnl requested via CPPFLAGS/CFLAGS so the UAF cannot ship silently.
+  case " $CPPFLAGS $CFLAGS " in
+    *Py_TSTATE_EXEC_HOME*)
+      _rl_eh_lto_ok=no
+      case "$ac_sys_system/$host_cpu" in
+        Linux/x86_64|Linux/amd64) _rl_eh_lto_ok=yes ;;
+        Darwin/arm64|Darwin/aarch64)
+          case "$CC" in
+            *gcc*|*g++*) _rl_eh_lto_ok=no ;;
+            *) _rl_eh_lto_ok=yes ;;
+          esac
+          ;;
+      esac
+      if test "$_rl_eh_lto_ok" != yes; then
+        AC_MSG_ERROR([Py_TSTATE_EXEC_HOME with --with-lto requires x86-64 Linux or arm64 Darwin/clang (inline TLS asm). Drop --with-lto, or use a supported toolchain.])
+      fi
+      ;;
+  esac
 fi
 
