+#  ifdef _Py_HAVE_TSTATE_TLS_READ
+/* Py_TSTATE_EXEC_HOME: _Py_tstate_tls_read() names this symbol inside an asm
+   string, which LTO cannot see.  Without `used`, thin LTO (--with-lto=thin)
+   drops the definition and the link fails with "symbol(s) defined in LTO
+   objects are referenced but missing in compiled objects".  Only defined where
+   the GNU-asm read exists, so the attribute is always available here. */
+_Py_thread_local PyThreadState *_Py_tss_tstate __attribute__((used)) = NULL;
+#  else
